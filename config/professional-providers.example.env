# Receita Federal via SERPRO/Conecta gov.br — CNPJ cadastral
SF_SERPRO_CLIENT_ID=
SF_SERPRO_CLIENT_SECRET=
SF_SERPRO_USER_CPF=
SF_SERPRO_TOKEN_URL=https://apigateway.conectagov.estaleiro.serpro.gov.br/oauth2/jwt-token
SF_SERPRO_CNPJ_URL=https://apigateway.conectagov.estaleiro.serpro.gov.br/api-cnpj-basica/v2/basica/{document}

# Serasa Experian — endpoint e produto dependem do contrato contratado.
# Nunca coloque estas credenciais no JavaScript ou no HTML.
SF_SERASA_ENDPOINT=
SF_SERASA_TOKEN_URL=
SF_SERASA_AUTH_MODE=bearer
SF_SERASA_TOKEN=
SF_SERASA_CLIENT_ID=
SF_SERASA_CLIENT_SECRET=
SF_SERASA_API_KEY=
SF_SERASA_DOCUMENT_FIELD=document
SF_SERASA_REPORT_CODE=
